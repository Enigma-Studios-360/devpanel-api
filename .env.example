# ============================================================
# DevHub API — variables de entorno
# Copia este archivo a `.env` y llena los valores.
# NUNCA subas tu `.env` real a git (ya está en .gitignore).
# ============================================================

# --- Servidor ---
PORT=4000
NODE_ENV=development

# --- MongoDB Atlas ---
# Formato: mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net
# Nombre de la base (sobrescribe cualquier /db de la URI)
MONGODB_DATABASE=devhub

# --- JWT ---
# Genera uno fuerte: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# También deriva la llave AES-256-GCM que cifra los tokens OAuth de los usuarios.
JWT_SECRET=change_me
JWT_EXPIRES_IN=1d

# --- CORS ---
# Orígenes permitidos, separados por coma
CORS_ORIGIN=http://localhost:4200

# --- Archivos ---
# Carpeta de uploads (relativa a la raíz del proyecto)
UPLOAD_DIR=uploads

# --- GitHub (integración de plataforma) ---
# PAT clásico con scope `repo` — SOLO para operaciones de la plataforma
# (nunca se usa para repos de usuarios; ellos usan su propio OAuth)
GITHUB_TOKEN=

# --- GitHub OAuth App (conexión por usuario) ---
# Crea una OAuth App en https://github.com/settings/developers
# Callback URL: <API_BASE_URL>/api/github/oauth/callback
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# --- URLs base (para el flujo OAuth y links absolutos) ---
API_BASE_URL=http://localhost:4000
WEB_BASE_URL=http://localhost:4200

# --- Vercel (wizard de deploy) ---
# Token de https://vercel.com/account/tokens
# NOTA: hoy el deploy es single-tenant (sale de esta cuenta). Ver docs/04_ROADMAP_TECNICO.md F1.2
VERCEL_TOKEN=
VERCEL_API_BASE=https://api.vercel.com
VERCEL_TEAM_ID=

# --- Asistente IA (DeepSeek) — opcional ---
# Sin key, el asistente responde en modo degradado
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
# Tope de tokens por respuesta (default del código: 400). Súbelo solo si aceptas mayor costo.
DEEPSEEK_MAX_TOKENS=400
# Mensajes por minuto por usuario (default del código: 12)
ASSISTANT_RATE_PER_MINUTE=12
# Emails con rate limit ampliado (separados por coma) — opcional
ASSISTANT_POWER_EMAILS=
